PORT=3000
CLIENT_URL=http://localhost:5173
# Full MongoDB connection string (includes credentials). This is the single
# place Mongo credentials are configured — no separate MONGODB_USERNAME/PASSWORD.
# WARNING: replace <username> and <password> with real credentials before using.
# Copying this example verbatim will fail to connect (and must never ship).
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/database
JWT_SECRET=your_jwt_secret_key

# OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# LiveKit WebRTC Credentials
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-dev-key-change-in-production
LIVEKIT_URL=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880

# Redis / BullMQ (for code execution queue)
# Use localhost:6379 by default, or set REDIS_URL for any Redis-compatible service.
# For Upstash Redis (TLS), use the rediss:// scheme, e.g.:
# WARNING: replace your_redis_password with a strong, unique password.
REDIS_URL=rediss://default:your_redis_password@us1-abled-whale-12345.upstash.io:6379
# Nodemailer Email Invitation Credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# AI Assistant (Groq) — powers the AI chat panel (Phase 2) and the agent engine.
# Requires GROQ_API_KEY; the assistant is disabled if it is missing.
GROQ_API_KEY=your_groq_api_key
# Default model for chat and agent. Must be a model Groq serves; the value is
# also listed first in the model picker. Common options: llama-3.3-70b-versatile,
# llama-3.1-8b-instant, llama-3.3-70b-specdec, mixtral-8x7b-32768, gemma2-9b-it.
GROQ_MODEL=llama-3.3-70b-versatile
# Overrides the Groq-compatible endpoint (used for proxies/mirrors).
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Max tokens per completion (upper bound for chat and each agent turn).
GROQ_MAX_TOKENS=2048
# Per-request timeout for Groq calls, in milliseconds.
GROQ_TIMEOUT_MS=120000
# Upper bound of context tokens fed to the model for a chat request.
AI_MAX_INPUT_TOKENS=64000
# Requests per user per room (rolling window).
AI_RATE_LIMIT=20

# AI Semantic Search (Phase 3) — optional semantic search over room contents.
# Provider: "local" (default, @xenova/transformers; model downloads once from
# Hugging Face) or "openai"/"jina"/"hf" (requires key + base URL below).
# Leave EMBEDDING_PROVIDER unset/disabled to skip embedding-based retrieval.
EMBEDDING_PROVIDER=local
# Local embedding model (Hugging Face id) or the remote model name for cloud
# providers (e.g. text-embedding-ada-002 for OpenAI, jina-embeddings-v2 for Jina).
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# Max context tokens allocated to retrieved chunks for semantic search queries.
AI_RETRIEVAL_TOKENS=6000

# AI Agent (Phase 4) — autonomous coding agent with tool calling.
# Max tool-call turns per agent run before it is forced to stop.
AI_AGENT_MAX_TURNS=8
# Max grep_symbol matches returned per call. If a pattern hits this cap the
# result is flagged as truncated so the agent can narrow its search.
MAX_GREP_MATCHES=60
# Max characters of a single tool result fed back to the model; larger outputs
# are truncated (and a marker is appended so the agent knows).
MAX_TOOL_OUTPUT_CHARS=12000
# Max messages retained in a user's stored AI conversation per room.
MAX_AI_CONVERSATION_MESSAGES=200
